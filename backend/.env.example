# Copy to .env and adjust for your machine
#
# Local SQLite (default):
# DATABASE_URL=sqlite:///./foundyourthing.db
#
# Supabase Postgres — Dashboard → Connect → Session pooler (best on Windows/IPv4):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Or Direct (needs IPv6 or IPv4 add-on):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./foundyourthing.db
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10
# Comma-separated origins for the hosted web app (or * for demos).
CORS_ORIGINS=*
# On Render with a persistent disk, use /var/data/uploads
UPLOAD_DIR=./uploads
# Keep photos after Render restarts (Project Settings → API):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role secret — never ship to the app
# SUPABASE_STORAGE_BUCKET=item-photos
MATCH_IMAGE_WEIGHT=0.85
MATCH_TEXT_WEIGHT=0.15
MATCH_THRESHOLD=0.55
# LiveGo: reject found-report photos that are not freshly camera-captured
LIVEGO_ENABLED=false
LIVE_PHOTO_MAX_AGE_MINUTES=30
