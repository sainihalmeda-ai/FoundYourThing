{
  "expo": {
    "name": "FYT",
    "slug": "foundyourthing",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09122C"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c42fe662-06fd-4195-aa8e-1cf332b5cb2b",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foundyourthing.app"
    },
    "android": {
      "package": "com.foundyourthing.app",
      "adaptiveIcon": {
        "backgroundColor": "#09122C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "usesCleartextTraffic": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow FoundYourThing to take photos of lost or found valuable items.",
          "photosPermission": "Allow FoundYourThing to choose photos of lost or found valuable items from your gallery."
        }
      ],
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "c42fe662-06fd-4195-aa8e-1cf332b5cb2b"
      }
    },
    "owner": "meda_sai_nihal"
  }
}
